 namespace ce::os {
 
+// ── The path the TARGET's dynamic linker will actually open ──
+// dlopen() resolves its argument inside the target's mount namespace, so a path
+// that exists here can be missing (or be a different file) in there: the Steam
+// Linux Runtime (pressure-vessel) and Flatpak shadow /usr with their own tree,
+// where e.g. /usr/bin/libspeedhack.so simply does not exist even though it does
+// outside. Both mount the host filesystem at /run/host, so that is the first
+// fallback; a chroot-style sandbox is reachable through the tracer's own root
+// (/proc/<tracer>/root), which the target can follow when it may ptrace us.
+//
+// The visibility test below is only a filter to avoid pointless retries — it
+// cannot prove the target may traverse the path (the tracer's /proc/<pid>/root
+// is refused to a target in a child user namespace). That is why the injector
+// tries the candidates for real, in order, and keeps the first one that gets
+// the library mapped.
+static bool pathVisibleToTarget(pid_t pid, const std::string& path) {
+    if (path.empty() || path.size() >= 4096) return false;
+    return ::access(("/proc/" + std::to_string(pid) + "/root" + path).c_str(), F_OK) == 0;
+}
+
+static std::vector<std::string> injectPathCandidates(pid_t pid, const std::string& soPath) {
+    std::vector<std::string> candidates{soPath};
+    if (pathVisibleToTarget(pid, soPath))
+        return candidates;   // common case: the target sees the path exactly as we do
+    std::string hostMount = "/run/host" + soPath;
+    std::string viaTracerRoot = "/proc/" + std::to_string(::getpid()) + "/root" + soPath;
+    for (const std::string& alt : {hostMount, viaTracerRoot})
+        if (alt != soPath && pathVisibleToTarget(pid, alt))
+            candidates.push_back(alt);
+    return candidates;
+}
+
+// Is a module whose basename is `base` mapped in the target? Used to verify an
+// injection actually took effect (a non-NULL dlopen return is not proof).
+static bool libraryMappedInTarget(pid_t pid, const std::string& base) {
+    std::ifstream maps("/proc/" + std::to_string(pid) + "/maps");
+    std::string line;
+    while (std::getline(maps, line))
+        if (line.find(base) != std::string::npos) return true;
+    return false;
+}
